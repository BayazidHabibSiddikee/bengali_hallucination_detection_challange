   "source": "# ===== CELL 12 \u2014 LEX/NUM (has_context) =====\ndef lexnum(df):\n    p=np.array([contain(r[\"response_bn\"],r[\"ctx_clean\"]) for _,r in df.iterrows()])\n    nu=np.array([len(numset(r[\"response_bn\"])-numset(r[\"ctx_clean\"])) for _,r in df.iterrows()])\n    s=0.7*p+0.3*(nu==0); s[df[\"no_ctx\"].values]=np.nan; return s\nlex_val=lexnum(sample); lex_test=lexnum(test)",
   "execution_count": 16,
   "outputs": []
  },
  {
   "cell_type": "code",
